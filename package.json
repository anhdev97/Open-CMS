{
  "name": "opencloudcms-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "OpenCloudCMS — storefront-first headless CMS (NestJS + Next.js) with schema-as-code",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^2.4.0",
      "multer": "^2.5.0",
      "qs": "^6.16.1",
      "fast-xml-parser": "^5.12.0",
      "uuid": "^11.1.1"
    }
  }
}
