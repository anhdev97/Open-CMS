{
  "name": "my-store",
  "private": true,
  "version": "0.1.0",
  "description": "Example OpenCloudCMS project: content types, generated code, migrations and one Next app (admin + website)",
  "scripts": {
    "opencloudcms": "opencloudcms",
    "dev": "opencloudcms migrate:up && tsx --tsconfig tsconfig.server.json src/main.ts",
    "build": "tsc -p tsconfig.server.json && next build",
    "start": "cross-env NODE_ENV=production node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@opencloudcms/core": "workspace:*",
    "@opencloudcms/schema": "workspace:*",
    "cross-env": "^10.1.0",
    "kysely": "^0.28.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@opencloudcms/cli": "workspace:*",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
