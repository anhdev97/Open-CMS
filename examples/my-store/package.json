{
  "name": "my-store",
  "private": true,
  "version": "0.1.0",
  "description": "Example opencms project (implementation layer): content types, generated code and migrations",
  "scripts": {
    "opencms": "opencms",
    "dev": "opencms migrate:up && tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@opencms/core": "workspace:*",
    "@opencms/schema": "workspace:*",
    "kysely": "^0.28.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "opencms-cli": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
