{
  "name": "@opencms/core",
  "version": "0.1.0",
  "description": "NestJS modules for opencms: content engine, admin and storefront APIs",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p admin/tsconfig.json && node -e \"require('fs').cpSync('admin/src/styles/theme.css','dist/admin/styles/theme.css')\"",
    "dev:admin": "tsc -w -p admin/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@opencms/assets": "workspace:*",
    "@opencms/codegen": "workspace:*",
    "@opencms/db": "workspace:*",
    "@opencms/oauth2": "workspace:*",
    "@opencms/schema": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "kysely": "^0.28.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/i18n.js",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./admin/layout": {
      "types": "./dist/admin/layout.d.ts",
      "default": "./dist/admin/layout.js"
    },
    "./admin/theme.css": {
      "style": "./dist/admin/styles/theme.css",
      "default": "./dist/admin/styles/theme.css"
    },
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
