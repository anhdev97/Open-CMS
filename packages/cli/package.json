{
  "name": "@opencloudcms/cli",
  "version": "0.1.0",
  "description": "opencms command line: generate code, create and run migrations, scaffold content types",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opencloudcms/schema": "workspace:*",
    "@opencloudcms/codegen": "workspace:*",
    "@opencloudcms/db": "workspace:*",
    "@opencloudcms/oauth2": "workspace:*",
    "commander": "^12.1.0",
    "jiti": "^2.4.0"
  },
  "bin": { "opencloudcms": "bin/opencloudcms.js" },
  "publishConfig": { "access": "public" }
}
